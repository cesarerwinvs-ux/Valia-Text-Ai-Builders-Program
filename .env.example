# ------------------------------------------------------------------
# Environment variables template.
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
#
# Public variables are prefixed with NEXT_PUBLIC_ and are exposed to the
# browser. NEVER put secrets in a NEXT_PUBLIC_ variable.
# Server-only variables (no prefix) stay on the server.
# Validation lives in src/lib/env.ts.
# ------------------------------------------------------------------

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_APP_NAME="Valia Web"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Server-only (never sent to the client) ---
# Example private variable. Optional by default (see src/lib/env.ts).
# DATABASE_URL="postgresql://user:password@localhost:5432/valia"
